{
  "name": "ae86-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Animated desktop reminder companion",
  "main": "app.js",
  "scripts": {
    "start": "electron .",
    "debug": "DEBUG=1 electron .",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^24.13.3"

  },
  "build": {
    "appId": "com.ae86.companion",
    "productName": "AE86 Companion",
    "asar": true,
    "asarUnpack": [
      "assets/**/*",
      "node_modules/three/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}